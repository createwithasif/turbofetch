{
  "manifest_version": 3,
  "name": "ADM Browser Integration",
  "version": "0.1.0",
  "description": "Sends your downloads and page videos to the ADM download manager.",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "webRequest", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "ADM", "default_popup": "popup.html" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
